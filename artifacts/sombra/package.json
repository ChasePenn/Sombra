{
  "name": "@workspace/sombra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "test:browser": "node --test tests/*.browser.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test $(find tests -name '*.test.js' ! -name '*.browser.test.js' | sort)"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@workspace/heat-safety": "workspace:*",
    "leaflet": "1.9.4"
  }
}
